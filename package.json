{
  "name": "sublicolor",
  "version": "1.0.0",
  "description": "Aplicación de gestión multicuenta elegante y minimalista conectada a Supabase",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "ofuscar": "node scripts/ofuscar.js",
    "build": "npm run ofuscar && electron-builder --win",
    "dist": "npm run ofuscar && electron-builder --win --x64",
    "publish": "npm run ofuscar && electron-builder --win -p always"
  },
  "keywords": [
    "electron",
    "sublicolor",
    "supabase",
    "multi-account"
  ],
  "author": "Sublicolor Team",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "axios": "^1.20.0",
    "crypto-js": "^4.2.0",
    "electron-updater": "^6.3.0",
    "https-proxy-agent": "^9.1.0",
    "node-machine-id": "^1.1.12",
    "puppeteer": "^25.9.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "javascript-obfuscator": "^5.6.0"
  },
  "build": {
    "appId": "com.sublicolor.app",
    "productName": "Sublicolor Access",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "Sublicolor_Portable.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "sublicolor-org",
        "repo": "sublicolor"
      }
    ]
  }
}
