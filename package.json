{
  "name": "sublicolor",
  "version": "1.0.1",
  "description": "Aplicación de gestión multicuenta elegante y minimalista conectada a Supabase",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "ofuscar": "node scripts/ofuscar.js",
    "build": "npm run ofuscar && electron-builder --win",
    "dist": "npm run ofuscar && electron-builder --win --x64",
    "release": "npm run ofuscar && electron-builder --win --publish always",
    "publish": "npm run release"
  },
  "keywords": [
    "electron",
    "sublicolor",
    "supabase",
    "multi-account"
  ],
  "author": "Sublicolor Team",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "axios": "^1.20.0",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "https-proxy-agent": "^9.1.0",
    "node-machine-id": "^1.1.12",
    "puppeteer": "^25.9.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "javascript-obfuscator": "^5.6.0"
  },
  "build": {
    "appId": "com.sublicolor.app",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Nilton92838374",
        "repo": "sublicolor"
      }
    ]
  }
}
